# Copy this file to .env.local and fill in the values. Never commit .env.local.

# 1) EMAIL (recommended): your Gmail address and a Gmail "App password"
#    (Google Account > Security > 2-Step Verification > App passwords). Server-only.
#    Needs a host that runs Node server code, such as Vercel.
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# 2) EMAIL fallback if SMTP is not set: free key from https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# 3) OPTIONAL instant WhatsApp alert to yourself via CallMeBot (free, personal use only).
CALLMEBOT_APIKEY=
WHATSAPP_PHONE=+6285397685933
